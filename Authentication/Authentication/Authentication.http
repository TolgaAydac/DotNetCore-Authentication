@Authentication_HostAddress = http://localhost:5008

### Register User
POST {{Authentication_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "username": "testuser",
  "email": "test@example.com",
  "password": "Password123!",
  "birthday": "1990-01-01T00:00:00",
  "gender": "Male"
}

### Login User
POST {{Authentication_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "Password123!"
}
